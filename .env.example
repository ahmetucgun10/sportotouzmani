# ============================================================
# SportAgent AI — Ortam Değişkenleri (Environment Variables)
# ============================================================
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
# Vercel'de bu değişkenleri "Project Settings > Environment Variables"
# bölümünden ekleyin.

# ------------------------------------------------------------
# 1) OpenAI API Anahtarı (AI ajan analizleri için) — ZORUNLU
#    https://platform.openai.com/api-keys
#    Sistem tam kurulum (canlı) modunda çalışır; bu anahtar olmadan
#    analiz başlatılamaz.
# ------------------------------------------------------------
OPENAI_API_KEY=

# ------------------------------------------------------------
# 2) Tavily API Anahtarı (gerçek zamanlı internet araştırması için) — ZORUNLU
#    https://app.tavily.com/  (ücretsiz katman mevcut)
#    Sistem tam kurulum (canlı) modunda çalışır; bu anahtar olmadan
#    internet araştırması yapılamaz.
# ------------------------------------------------------------
TAVILY_API_KEY=

# ------------------------------------------------------------
# 3) PostgreSQL Veritabanı (analiz geçmişini kaydetmek için — OPSİYONEL)
#    Vercel sunucusuz olduğu için bulut tabanlı bir PostgreSQL önerilir:
#    - Neon:     https://neon.tech      (ücretsiz)
#    - Supabase: https://supabase.com   (ücretsiz)
#    Eksikse: uygulama çalışır ama analizler kaydedilmez (geçmiş yok).
#    Örnek: postgresql://user:pass@host/dbname?sslmode=require
# ------------------------------------------------------------
DATABASE_URL=
